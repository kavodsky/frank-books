{"id": "de-001", "lang": "de", "source": "Er ruft seine Mutter an.", "reference_uk": "Він телефонує своїй матері.", "tags": ["separable_verb"]}
{"id": "de-002", "lang": "de", "source": "Steh bitte sofort auf!", "reference_uk": "Будь ласка, негайно вставай!", "tags": ["separable_verb"]}
{"id": "de-003", "lang": "de", "source": "Sie kommt morgen mit.", "reference_uk": "Вона завтра піде з нами.", "tags": ["separable_verb"]}
{"id": "de-004", "lang": "de", "source": "Mach das Fenster zu!", "reference_uk": "Зачини вікно!", "tags": ["separable_verb"]}
{"id": "de-005", "lang": "de", "source": "Der Zug kommt um acht an.", "reference_uk": "Поїзд прибуває о восьмій.", "tags": ["separable_verb"]}
{"id": "de-006", "lang": "de", "source": "Er steigt in Berlin aus.", "reference_uk": "Він виходить у Берліні.", "tags": ["separable_verb"]}
{"id": "de-007", "lang": "de", "source": "Ich rufe dich später an.", "reference_uk": "Я тобі пізніше зателефоную.", "tags": ["separable_verb"]}
{"id": "de-008", "lang": "de", "source": "Sie sieht wie ihre Mutter aus.", "reference_uk": "Вона виглядає як її мати.", "tags": ["separable_verb"]}
{"id": "de-009", "lang": "de", "source": "Wir fangen morgen an.", "reference_uk": "Ми починаємо завтра.", "tags": ["separable_verb"]}
{"id": "de-010", "lang": "de", "source": "Er zieht den Mantel aus.", "reference_uk": "Він знімає пальто.", "tags": ["separable_verb"]}
{"id": "de-011", "lang": "de", "source": "Sie macht das Licht an.", "reference_uk": "Вона вмикає світло.", "tags": ["separable_verb"]}
{"id": "de-012", "lang": "de", "source": "Bring bitte die Kinder mit!", "reference_uk": "Будь ласка, приведи дітей із собою!", "tags": ["separable_verb"]}
{"id": "de-013", "lang": "de", "source": "Der Lehrer sieht das Heft durch.", "reference_uk": "Учитель переглядає зошит.", "tags": ["separable_verb"]}
{"id": "de-014", "lang": "de", "source": "Ich schließe die Tür auf.", "reference_uk": "Я відмикаю двері.", "tags": ["separable_verb"]}
{"id": "de-015", "lang": "de", "source": "Sie räumt das Zimmer auf.", "reference_uk": "Вона прибирає кімнату.", "tags": ["separable_verb"]}
{"id": "de-016", "lang": "de", "source": "Wir gehen heute Abend aus.", "reference_uk": "Ми сьогодні ввечері йдемо гуляти.", "tags": ["separable_verb"]}
{"id": "de-017", "lang": "de", "source": "Er gibt das Buch zurück.", "reference_uk": "Він повертає книжку.", "tags": ["separable_verb"]}
{"id": "de-018", "lang": "de", "source": "Die Sonne geht im Westen unter.", "reference_uk": "Сонце заходить на заході.", "tags": ["separable_verb"]}
{"id": "de-019", "lang": "de", "source": "Nimm die Schuhe aus!", "reference_uk": "Зніми черевики!", "tags": ["separable_verb"]}
{"id": "de-020", "lang": "de", "source": "Wenn er Zeit hat, kommt er mit.", "reference_uk": "Якщо матиме час, він піде з нами.", "tags": ["separable_verb"]}
{"id": "de-021", "lang": "de", "source": "Bevor sie aussteigt, nimmt sie den Koffer.", "reference_uk": "Перш ніж вийти, вона бере валізу.", "tags": ["separable_verb"]}
{"id": "de-022", "lang": "de", "source": "Sie findet den Schlüssel nicht.", "reference_uk": "Вона не знаходить ключа.", "tags": []}
{"id": "de-023", "lang": "de", "source": "Der Hund liegt unter dem Tisch.", "reference_uk": "Собака лежить під столом.", "tags": []}
{"id": "de-024", "lang": "de", "source": "Ich habe gestern einen Brief geschrieben.", "reference_uk": "Я вчора написав листа.", "tags": []}
{"id": "de-025", "lang": "de", "source": "Wo wohnst du?", "reference_uk": "Де ти живеш?", "tags": []}
{"id": "de-026", "lang": "de", "source": "Das Kind spielt im Garten.", "reference_uk": "Дитина грається в саду.", "tags": []}
{"id": "de-027", "lang": "de", "source": "Sie kauft Brot und Milch.", "reference_uk": "Вона купує хліб і молоко.", "tags": []}
{"id": "de-028", "lang": "de", "source": "Wir essen um zwölf zu Mittag.", "reference_uk": "Ми обідаємо о дванадцятій.", "tags": []}
{"id": "de-029", "lang": "de", "source": "Der alte Mann liest eine Zeitung.", "reference_uk": "Старий чоловік читає газету.", "tags": []}
{"id": "de-030", "lang": "de", "source": "Kannst du mir bitte helfen?", "reference_uk": "Можеш мені, будь ласка, допомогти?", "tags": []}
{"id": "de-031", "lang": "de", "source": "Es regnet seit dem Morgen.", "reference_uk": "Дощ іде з ранку.", "tags": []}
{"id": "de-032", "lang": "de", "source": "Die Tür ist geschlossen.", "reference_uk": "Двері зачинені.", "tags": []}
{"id": "de-033", "lang": "de", "source": "Er spricht langsam und deutlich.", "reference_uk": "Він говорить повільно і чітко.", "tags": []}
{"id": "de-034", "lang": "de", "source": "Ich möchte einen Kaffee trinken.", "reference_uk": "Я хотів би випити кави.", "tags": []}
{"id": "de-035", "lang": "de", "source": "Die Kinder gehen in die Schule.", "reference_uk": "Діти йдуть до школи.", "tags": []}
{"id": "de-036", "lang": "de", "source": "Sie hat das Fenster geöffnet.", "reference_uk": "Вона відчинила вікно.", "tags": []}
{"id": "de-037", "lang": "de", "source": "Wann kommt der Bus?", "reference_uk": "Коли приїде автобус?", "tags": []}
{"id": "de-038", "lang": "de", "source": "Mein Bruder arbeitet in Wien.", "reference_uk": "Мій брат працює у Відні.", "tags": []}
{"id": "de-039", "lang": "de", "source": "Wir haben keine Zeit.", "reference_uk": "У нас немає часу.", "tags": []}
{"id": "de-040", "lang": "de", "source": "Das Buch liegt auf dem Tisch.", "reference_uk": "Книжка лежить на столі.", "tags": []}
{"id": "de-041", "lang": "de", "source": "Er ist größer als sein Vater.", "reference_uk": "Він вищий за свого батька.", "tags": []}
{"id": "de-042", "lang": "de", "source": "Ich verstehe die Frage nicht.", "reference_uk": "Я не розумію питання.", "tags": []}
{"id": "de-043", "lang": "de", "source": "Sie bleibt heute zu Hause.", "reference_uk": "Вона сьогодні залишається вдома.", "tags": []}
{"id": "de-044", "lang": "de", "source": "Der Vogel fliegt über das Haus.", "reference_uk": "Птах летить над будинком.", "tags": []}
{"id": "de-045", "lang": "de", "source": "Bitte öffnen Sie die Tür.", "reference_uk": "Будь ласка, відчиніть двері.", "tags": ["formal_address"]}
{"id": "de-046", "lang": "de", "source": "Hast du den Brief schon gelesen?", "reference_uk": "Ти вже прочитав листа?", "tags": []}
{"id": "de-047", "lang": "de", "source": "Die Milch ist sauer.", "reference_uk": "Молоко скисле.", "tags": []}
{"id": "de-048", "lang": "de", "source": "Wir treffen uns am Bahnhof.", "reference_uk": "Ми зустрінемося на вокзалі.", "tags": []}
{"id": "de-049", "lang": "de", "source": "Er erzählt eine lange Geschichte.", "reference_uk": "Він розповідає довгу історію.", "tags": []}
{"id": "de-050", "lang": "de", "source": "Ich gehe jetzt schlafen.", "reference_uk": "Я зараз іду спати.", "tags": []}
{"id": "de-051", "lang": "de", "source": "Das Wetter ist heute schön.", "reference_uk": "Сьогодні гарна погода.", "tags": []}
{"id": "de-052", "lang": "de", "source": "Sie wartet auf ihre Freundin.", "reference_uk": "Вона чекає на подругу.", "tags": []}
