{"id": "hu-001", "lang": "hu", "source": "Olvasd el a levelet!", "reference_uk": "Прочитай листа!", "tags": ["preverb"]}
{"id": "hu-002", "lang": "hu", "source": "El tudta olvasni a könyvet.", "reference_uk": "Він зміг прочитати книжку.", "tags": ["preverb"]}
{"id": "hu-003", "lang": "hu", "source": "Írd meg a leckét!", "reference_uk": "Напиши завдання!", "tags": ["preverb"]}
{"id": "hu-004", "lang": "hu", "source": "Kimegyek a kertbe.", "reference_uk": "Я вийду в сад.", "tags": ["preverb"]}
{"id": "hu-005", "lang": "hu", "source": "Gyere be a házba!", "reference_uk": "Заходь у хату!", "tags": ["preverb"]}
{"id": "hu-006", "lang": "hu", "source": "Felállt a székről.", "reference_uk": "Він устав зі стільця.", "tags": ["preverb"]}
{"id": "hu-007", "lang": "hu", "source": "Letette a táskát az asztalra.", "reference_uk": "Він поклав сумку на стіл.", "tags": ["preverb"]}
{"id": "hu-008", "lang": "hu", "source": "Megnézte a filmet.", "reference_uk": "Він подивився фільм.", "tags": ["preverb"]}
{"id": "hu-009", "lang": "hu", "source": "Visszajövök holnap.", "reference_uk": "Я повернуся завтра.", "tags": ["preverb"]}
{"id": "hu-010", "lang": "hu", "source": "Add ide a kulcsot!", "reference_uk": "Дай сюди ключ!", "tags": ["preverb"]}
{"id": "hu-011", "lang": "hu", "source": "Szétvágták a kenyeret.", "reference_uk": "Вони розрізали хліб.", "tags": ["preverb"]}
{"id": "hu-012", "lang": "hu", "source": "Átmentünk a hídon.", "reference_uk": "Ми перейшли міст.", "tags": ["preverb"]}
{"id": "hu-013", "lang": "hu", "source": "Körülnézett a szobában.", "reference_uk": "Він озирнувся в кімнаті.", "tags": ["preverb"]}
{"id": "hu-014", "lang": "hu", "source": "Összerakták a bőröndöt.", "reference_uk": "Вони склали валізу.", "tags": ["preverb"]}
{"id": "hu-015", "lang": "hu", "source": "Végigment az utcán.", "reference_uk": "Він пройшов вулицею.", "tags": ["preverb"]}
{"id": "hu-016", "lang": "hu", "source": "Be tudta fejezni a munkát.", "reference_uk": "Він зміг закінчити роботу.", "tags": ["preverb"]}
{"id": "hu-017", "lang": "hu", "source": "Nem megyek el ma sehova.", "reference_uk": "Я сьогодні нікуди не піду.", "tags": ["preverb"]}
{"id": "hu-018", "lang": "hu", "source": "Kérlek, nyisd ki az ablakot!", "reference_uk": "Будь ласка, відчини вікно!", "tags": ["preverb"]}
{"id": "hu-019", "lang": "hu", "source": "Ha végez, jöjjön be.", "reference_uk": "Як закінчить, нехай зайде.", "tags": ["preverb"]}
{"id": "hu-020", "lang": "hu", "source": "Mielőtt elment, bezárta az ajtót.", "reference_uk": "Перш ніж піти, він замкнув двері.", "tags": ["preverb"]}
{"id": "hu-021", "lang": "hu", "source": "A kutya a ház előtt ül.", "reference_uk": "Собака сидить перед хатою.", "tags": []}
{"id": "hu-022", "lang": "hu", "source": "Hol lakik a barátod?", "reference_uk": "Де живе твій друг?", "tags": []}
{"id": "hu-023", "lang": "hu", "source": "A gyerek a kertben játszik.", "reference_uk": "Дитина грається в саду.", "tags": []}
{"id": "hu-024", "lang": "hu", "source": "Kérek egy pohár vizet.", "reference_uk": "Прошу склянку води.", "tags": []}
{"id": "hu-025", "lang": "hu", "source": "A könyv az asztalon van.", "reference_uk": "Книжка на столі.", "tags": []}
{"id": "hu-026", "lang": "hu", "source": "Este hétkor vacsorázunk.", "reference_uk": "Вечеряємо о сьомій вечора.", "tags": []}
{"id": "hu-027", "lang": "hu", "source": "A tanár a táblára ír.", "reference_uk": "Учитель пише на дошці.", "tags": []}
{"id": "hu-028", "lang": "hu", "source": "Szeretsz kávét inni?", "reference_uk": "Ти любиш пити каву?", "tags": []}
{"id": "hu-029", "lang": "hu", "source": "Az anyám a konyhában főz.", "reference_uk": "Моя мама готує на кухні.", "tags": []}
{"id": "hu-030", "lang": "hu", "source": "Nem értem a kérdést.", "reference_uk": "Я не розумію питання.", "tags": []}
{"id": "hu-031", "lang": "hu", "source": "Holnap Budapestre utazom.", "reference_uk": "Завтра їду до Будапешта.", "tags": []}
{"id": "hu-032", "lang": "hu", "source": "A vonat nyolckor indul.", "reference_uk": "Поїзд відходить о восьмій.", "tags": []}
{"id": "hu-033", "lang": "hu", "source": "A macska a fa alatt alszik.", "reference_uk": "Кіт спить під деревом.", "tags": []}
{"id": "hu-034", "lang": "hu", "source": "Ez a ház nagyon régi.", "reference_uk": "Цей будинок дуже старий.", "tags": []}
{"id": "hu-035", "lang": "hu", "source": "A fiú magasabb, mint az apja.", "reference_uk": "Хлопець вищий за свого батька.", "tags": []}
{"id": "hu-036", "lang": "hu", "source": "Nincs időnk.", "reference_uk": "У нас немає часу.", "tags": []}
{"id": "hu-037", "lang": "hu", "source": "Esik az eső egész délelőtt.", "reference_uk": "Дощ іде весь ранок.", "tags": []}
{"id": "hu-038", "lang": "hu", "source": "A boltban kenyeret veszek.", "reference_uk": "Я купую хліб у крамниці.", "tags": []}
{"id": "hu-039", "lang": "hu", "source": "Mikor jön a busz?", "reference_uk": "Коли приїде автобус?", "tags": []}
{"id": "hu-040", "lang": "hu", "source": "A madár a ház fölött repül.", "reference_uk": "Птах летить над будинком.", "tags": []}
{"id": "hu-041", "lang": "hu", "source": "Maradj otthon ma!", "reference_uk": "Залишся сьогодні вдома!", "tags": []}
{"id": "hu-042", "lang": "hu", "source": "A levél a fiókban van.", "reference_uk": "Лист у шухляді.", "tags": []}
{"id": "hu-043", "lang": "hu", "source": "Tegezlek, mert barátok vagyunk.", "reference_uk": "Я кажу тобі «ти», бо ми друзі.", "tags": ["t_address"]}
{"id": "hu-044", "lang": "hu", "source": "Maga mit kíván?", "reference_uk": "Що ви бажаєте?", "tags": ["v_address"]}
{"id": "hu-045", "lang": "hu", "source": "Jó reggelt kívánok!", "reference_uk": "Бажаю доброго ранку!", "tags": []}
{"id": "hu-046", "lang": "hu", "source": "A víz hideg.", "reference_uk": "Вода холодна.", "tags": []}
{"id": "hu-047", "lang": "hu", "source": "A gyerekek iskolába mennek.", "reference_uk": "Діти йдуть до школи.", "tags": []}
{"id": "hu-048", "lang": "hu", "source": "Hallod a zenét?", "reference_uk": "Ти чуєш музику?", "tags": []}
{"id": "hu-049", "lang": "hu", "source": "A kulcs az ajtóban maradt.", "reference_uk": "Ключ лишився в дверях.", "tags": []}
{"id": "hu-050", "lang": "hu", "source": "Este sétálunk a parkban.", "reference_uk": "Увечері гуляємо в парку.", "tags": []}
{"id": "hu-051", "lang": "hu", "source": "A nagyapa mesét mond.", "reference_uk": "Дідусь розповідає казку.", "tags": []}
{"id": "hu-052", "lang": "hu", "source": "Nem találom a szemüvegemet.", "reference_uk": "Я не знаходжу окулярів.", "tags": []}
